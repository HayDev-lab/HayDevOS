// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Enquiry from the HayDev contact form (port of the D1 `leads` table).
model Lead {
  id             String   @id
  name           String
  email          String
  message        String
  consentVersion String
  createdAt      DateTime @default(now())

  @@index([email, createdAt])
}

// ===========================================================================
// HAYDEV LEADOS — demo product schema (prefixed Ld* to coexist with the
// marketing Lead table). Same structure as the standalone LeadOS repo.
// ===========================================================================

model LdOrganization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  locale    String   @default("hy") // hy | ru | en
  timezone  String   @default("Asia/Yerevan")
  currency  String   @default("AMD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                LdUser[]
  leads                LdLead[]
  pipelines            LdPipeline[]
  leadSources          LdLeadSource[]
  tags                 LdTag[]
  lostReasons          LdLostReason[]
  businessAudits       LdBusinessAudit[]
  integrationSyncs     LdIntegrationSync[]
  integrationEvents    LdIntegrationEvent[]
  incomingMessages     LdIncomingMessage[]
  webhookLogs           LdWebhookLog[]
  notifications         LdNotification[]
  customFields         LdCustomField[]
  scoringConfigs       LdScoringConfig[]
  settings             LdSetting[]
  savedFilters         LdSavedFilter[]
  assignmentRules      LdAssignmentRule[]
  webhookEndpoints     LdWebhookEndpoint[]
  activities           LdActivity[]
  tasks                LdTask[]
  notes                LdNote[]
  leadEvents           LdLeadEvent[]
  lostLeadFlags        LdLostLeadFlag[]
}

model LdUser {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String
  role           String       @default("MANAGER") // UserRole
  status         String       @default("ACTIVE") // UserStatus
  title          String?
  phone          String?
  avatarColor    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization       LdOrganization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownedLeads         LdLead[]             @relation("OwnedLeads")
  assignedTasks      LdTask[]             @relation("AssignedTasks")
  assignmentRules    LdAssignmentRule[]   @relation("AssignmentRuleAssignee")
  activities         LdActivity[]
  notes              LdNote[]
  events             LdLeadEvent[]
  notifications      LdNotification[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model LdLeadSource {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           String       @default("manual") // website | business_audit | instagram | facebook | whatsapp | telegram | google_ads | meta_ads | referral | manual | api | email | phone | other
  position       Int          @default(0)
  isSystem       Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        LdLead[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model LdPipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization LdOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       LdPipelineStage[]
  leads       LdLead[]

  @@index([organizationId])
}

model LdPipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  position    Int
  type        String   @default("open") // open | won | lost
  color       String?
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())

  pipeline LdPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    LdLead[]

  @@index([pipelineId])
}

model LdTag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String?
  createdAt      DateTime @default(now())

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadTags      LdLeadTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model LdLead {
  id              String   @id @default(cuid())
  organizationId  String
  externalId      String?
  sourceId        String?
  sourceDetail    String?  // e.g. landing page name, campaign, form id
  firstName       String?
  lastName        String?
  company         String?
  position        String?  // job title
  phone           String?
  normalizedPhone String?
  email           String?
  normalizedEmail String?
  preferredChannel String? // PreferredChannel
  locale          String?
  status          String   @default("NEW") // LeadStatus
  pipelineId      String?
  stageId         String?
  ownerId         String?
  priority        String   @default("MEDIUM") // Priority
  leadScore       Int      @default(0)
  scoreCategory   String   @default("LOW") // ScoreCategory
  estimatedValue  Int?
  currency        String?
  summary         String?
  requirements    String?
  lostReason      String?
  lostNotes       String?
  lastContactAt   DateTime?
  nextActionAt    DateTime?
  nextActionLabel String?
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    LdOrganization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source          LdLeadSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  pipeline        LdPipeline?        @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage           LdPipelineStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  owner           LdUser?            @relation("OwnedLeads", fields: [ownerId], references: [id], onDelete: SetNull)

  activities      LdActivity[]
  tasks           LdTask[]
  notes           LdNote[]
  events          LdLeadEvent[]
  scoreComponents LdLeadScoreComponent[]
  leadTags        LdLeadTag[]
  audits          LdBusinessAudit[]
  customValues    LdCustomFieldValue[]
  flags           LdLostLeadFlag[]
  attributions    LdSourceAttribution[]
  incomingMessages LdIncomingMessage[]
  integrationSyncs LdIntegrationSync[]
  integrationEvents LdIntegrationEvent[]
  notifications   LdNotification[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, ownerId])
  @@index([organizationId, stageId])
  @@index([organizationId, status])
  @@index([organizationId, sourceId])
  @@index([organizationId, nextActionAt])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
}

model LdLeadTag {
  id        String @id @default(cuid())
  leadId    String
  tagId     String
  createdAt DateTime @default(now())

  lead LdLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  LdTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
  @@index([tagId])
}

model LdLeadScoreComponent {
  id        String   @id @default(cuid())
  leadId    String
  reason    String   // human readable reason
  key       String   // machine key: audit_completed, budget_indicated, ...
  delta     Int      // signed points
  createdAt DateTime @default(now())

  lead LdLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LdLostLeadFlag {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String
  reason         String    // no_contact | overdue_followup | no_activity | proposal_no_followup | meeting_no_next | unassigned
  message        String
  severity       String    @default("warning") // info | warning | critical
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?

  lead         LdLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resolvedAt])
  @@index([leadId])
  @@index([reason])
}

model LdActivity {
  id          String   @id @default(cuid())
  organizationId String
  leadId      String
  userId      String?
  type        String   // ActivityType
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         LdLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         LdUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([organizationId])
}

model LdTask {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String?
  assignedTo     String?
  title          String
  description    String?
  dueAt          DateTime?
  status         String    @default("TODO") // TaskStatus
  priority       String    @default("MEDIUM") // Priority
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         LdLead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignee     LdUser?         @relation("AssignedTasks", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, assignedTo])
  @@index([organizationId, dueAt])
  @@index([leadId])
}

model LdNote {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  userId         String?
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         LdLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         LdUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model LdLeadEvent {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  userId         String?
  type           String   // LeadEventType
  payload        Json?
  createdAt      DateTime @default(now())

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         LdLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         LdUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([organizationId, type])
}

model LdBusinessAudit {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  externalId     String?
  companyName    String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  locale         String?
  acquisition    Int      @default(0)
  sales          Int      @default(0)
  operations     Int      @default(0)
  data           Int      @default(0)
  automation     Int      @default(0)
  aiReadiness    Int      @default(0)
  automationMap  Json?
  priorityAutomations Json?
  recommendations Json?
  reportSummary  String?
  payload        Json?
  createdAt      DateTime @default(now())

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         LdLead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId])
}

model LdIntegrationSync {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String?
  provider       String    @default("HAYDEV_ERP") // HAYDEV_ERP | HAYDEV_CRM | ...
  externalRefId  String?
  entity         String    @default("lead") // lead | customer | deal | project
  direction      String    @default("outbound") // outbound | inbound
  status         String    @default("PENDING") // SyncStatus
  payload        Json?
  response       Json?
  error          String?
  attempts       Int       @default(0)
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         LdLead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([leadId])
}

model LdIntegrationEvent {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  event          String   // lead.created | lead.assigned | lead.stage_changed | ...
  payload        Json?
  published      Boolean  @default(false)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         LdLead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, published])
  @@index([event])
}

model LdWebhookLog {
  id             String   @id @default(cuid())
  organizationId String
  source         String
  endpoint       String?
  status         String   @default("OK") // OK | FAILED
  payload        Json?
  response       Json?
  error          String?
  createdAt      DateTime @default(now())

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model LdIncomingMessage {
  id                String   @id @default(cuid())
  organizationId    String
  source            String   // instagram | facebook | whatsapp | telegram | email | website | api
  externalMessageId String?
  leadId            String?
  conversationId    String?
  direction         String   @default("inbound") // inbound | outbound
  content           String
  channel           String?  // dm | comment | form | email | ...
  fromHandle        String?
  metadata          Json?
  timestamp         DateTime @default(now())
  createdAt         DateTime @default(now())

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         LdLead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, source])
  @@index([leadId])
  @@index([conversationId])
}

model LdSourceAttribution {
  id          String   @id @default(cuid())
  leadId      String
  source      String?
  campaign    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  landingPage String?
  referrer    String?
  createdAt   DateTime @default(now())

  lead LdLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([utmSource])
}

model LdLostReason {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  position       Int      @default(0)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model LdNotification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  leadId         String?
  type           String
  title          String
  message        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         LdUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead         LdLead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, read])
}

model LdCustomField {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  key            String
  type           String   @default("text") // text | number | select | multiselect | date | bool
  options        Json?
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  organization LdOrganization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       LdCustomFieldValue[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model LdCustomFieldValue {
  id          String    @id @default(cuid())
  leadId      String
  fieldId     String
  valueText   String?
  valueNumber  Float?
  valueBool   Boolean?
  valueDate   DateTime?

  lead  LdLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  field LdCustomField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, fieldId])
  @@index([fieldId])
}

model LdScoringConfig {
  id             String   @id @default(cuid())
  organizationId String
  key            String   // audit_completed | budget_indicated | urgency_high | ...
  label          String
  points         Int      @default(0)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model LdSetting {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  value          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model LdSavedFilter {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  name           String
  query          Json
  isShared       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([organizationId, isShared])
}

model LdAssignmentRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sourceId       String?
  sourceType     String?
  priority       String?
  assigneeId     String
  enabled        Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     LdUser          @relation("AssignmentRuleAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled])
}

model LdWebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  url            String
  secret         String?
  events         String   // comma-separated event names, or "*" for all
  enabled        Boolean  @default(true)
  lastDeliveryAt DateTime?
  lastStatus     String?  // OK | FAILED
  failCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization LdOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled])
}
