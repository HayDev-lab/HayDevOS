[Unit]
Description=HayDevOS encrypted PostgreSQL and private Storage backup
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/haydevos/backup.env

[Service]
Type=oneshot
User=haydevos
Group=haydevos
WorkingDirectory=/opt/haydevos/current
EnvironmentFile=/etc/haydevos/haydevos.env
EnvironmentFile=/etc/haydevos/backup.env
ExecStart=/usr/local/bin/node scripts/backup-production.mjs
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/haydevos
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
