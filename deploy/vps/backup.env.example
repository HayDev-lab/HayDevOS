# Install as /etc/haydevos/backup.env only after /var/backups/haydevos is an
# access-controlled encrypted destination outside the application release.
BACKUP_DIR=/var/backups/haydevos
BACKUP_DESTINATION_CONFIRMED_ENCRYPTED=NO
DIRECT_URL=postgresql://migration-owner:replace-me@session-pooler.example:5432/postgres?sslmode=require
