[Unit]
Description=HayDevOS local dependency readiness probe
After=haydevos.service

[Service]
Type=oneshot
User=haydevos
Group=haydevos
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 120 http://127.0.0.1:3000/api/ready
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
