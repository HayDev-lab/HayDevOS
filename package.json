{
  "name": "haydevos",
  "version": "0.2.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "release:package": "node scripts/package-vps-release.mjs",
    "openclaw:broker": "node scripts/openclaw-broker.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "security:audit": "npm audit --audit-level=high",
    "db:check": "prisma validate && prisma migrate status",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:sqlite": "node scripts/migrate-sqlite-to-postgres.mjs",
    "db:verify:sqlite": "node scripts/migrate-sqlite-to-postgres.mjs --verify-only",
    "storage:configure": "node scripts/configure-document-storage.mjs",
    "storage:reconcile": "node scripts/verify-document-storage.mjs",
    "storage:smoke": "node scripts/smoke-document-storage.mjs",
    "production:smoke": "node scripts/production-smoke.mjs",
    "backup:production": "node scripts/backup-production.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "test:postgres-isolation": "node tests/postgres-tenant-isolation.mjs",
    "test:http-smoke": "node tests/http-production-smoke.mjs",
    "test:leados": "node tests/leados-production.mjs",
    "test:leados-org-switch": "node tests/leados-org-switch.mjs",
    "test:owner-ai-leados": "node tests/owner-ai-leados.mjs",
    "test:owner-ai-quoteflow": "node tests/owner-ai-quoteflow.mjs",
    "test:owner-ai-documentflow": "node tests/owner-ai-documentflow.mjs",
    "test:owner-ai-erp": "node tests/owner-ai-erp.mjs",
    "test:openclaw-broker": "bun test tests/openclaw-broker.test.mjs",
    "test:sla": "bun test tests/leados-sla.test.ts",
    "test:quoteflow-pricing": "bun test tests/quoteflow-pricing.test.ts",
    "test:quoteflow": "node tests/quoteflow-production.mjs",
    "test:documentflow": "bun --conditions=react-server test tests/documentflow-artifacts.test.ts",
    "test:malware": "bun --conditions=react-server test tests/malware-scanner.test.ts",
    "test:documentflow:http": "node tests/documentflow-production.mjs",
    "test:quoteflow-org-switch": "node tests/quoteflow-org-switch.mjs",
    "test:erp": "node tests/erp-production.mjs",
    "test:erp-restart": "node tests/erp-restart.mjs",
    "test:erp-automation": "bun --conditions=react-server test tests/erp-automation.test.ts",
    "test:security-structure": "bun test tests/api-security-coverage.test.ts tests/production-environment.test.ts tests/owner-ai-protocol.test.ts tests/owner-ai-action-authorization.test.ts tests/owner-ai-provider.test.ts tests/openclaw-broker.test.mjs",
    "test:security-integration": "node scripts/run-security-integration.mjs",
    "db:verify:inventory": "node scripts/verify-inventory-integrity.mjs",
    "db:verify:erp-finance": "node scripts/verify-erp-finance.mjs",
    "test": "npm run test:sla && npm run test:quoteflow-pricing && npm run test:postgres-isolation",
    "db:seed": "bun run src/lib/seed.ts",
    "auth:bootstrap": "node scripts/bootstrap-admin.mjs",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/storage-js": "2.117.2",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.7.2",
    "fflate": "^0.8.3",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.20.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "^6.11.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
