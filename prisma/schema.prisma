// HayDevOS — Multi-tenant enterprise platform schema
// SQLite-compatible: no enums, no String[]. Roles/statuses stored as String
// with app-level validation. Lists encoded as JSON strings where needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// CORE — Identity, tenancy, sessions, audit, notifications, module registry
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatarUrl    String?
  passwordHash String?
  locale       String   @default("hy")
  defaultOrgId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  sessions        Session[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  uploadedDocs    DocumentRecord[]
  tasksAssigned   Task[]       @relation("TaskAssignee")
  tasksOwned      Task[]       @relation("TaskOwner")
  leadOwnership   Lead[]
  aiConversations AiConversation[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("starter") // starter | growth | scale | enterprise
  createdAt DateTime @default(now())

  memberships     Membership[]
  sessions        Session[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  moduleRegistry  ModuleRegistry[]
  leads           Lead[]
  tasks           Task[]
  quotes          Quote[]
  products        Product[]
  priceBooks      PriceBook[]
  documents       DocumentRecord[]
  automations     Automation[]
  customers       Customer[]
  orders          Order[]
  invoices        Invoice[]
  payments        Payment[]
  integrations    Integration[]
  webhookEvents   WebhookEvent[]
  auditQs         AuditQuestionnaire[]
  aiConversations AiConversation[]
  leadActivities  LeadActivity[]
  automationRuns  AutomationRun[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      String   @default("MEMBER") // OWNER | ADMIN | MANAGER | MEMBER | VIEWER
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  orgId     String?
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   String? // JSON-encoded
  createdAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  type      String   // info | success | warning | error | mention | sla | system
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([orgId, createdAt])
}

model ModuleRegistry {
  id        String   @id @default(cuid())
  orgId     String
  moduleKey String   // leados | quoteflow | docsmart | autopilot | erphub | connect | control | ownerAi | audit | settings
  enabled   Boolean  @default(true)
  config    String?  // JSON-encoded per-org module config
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, moduleKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// LEADOS — Leads, activities, tasks
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  email           String?
  phone           String?
  company         String?
  source          String?  // web | referral | outbound | inbound | event | partner
  stage           String   @default("new") // new | contacted | qualified | proposal | negotiation | won | lost
  ownerId         String?
  value           Float    @default(0)
  firstResponseAt DateTime?
  lastActivityAt  DateTime?
  slaDueAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities LeadActivity[]
  tasks      Task[]
  quotes     Quote[]

  @@index([orgId, stage])
  @@index([orgId, ownerId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  orgId     String
  type      String   // note | call | email | meeting | status_change | system
  body      String
  createdAt DateTime @default(now())

  lead Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  org  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Task {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  description String?
  assigneeId  String?
  ownerId     String?
  leadId      String?
  dueAt       DateTime?
  priority    String   @default("medium") // low | medium | high | urgent
  status      String   @default("todo") // todo | in_progress | done | blocked | cancelled
  createdAt   DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  owner    User?        @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lead     Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([assigneeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// QUOTEFLOW — Quotes, quote items, products, price books
// ─────────────────────────────────────────────────────────────────────────────

model Quote {
  id         String   @id @default(cuid())
  orgId      String
  number     String
  leadId     String?
  customerId String?
  status     String   @default("draft") // draft | sent | accepted | rejected | expired
  currency   String   @default("USD")
  subtotal   Float    @default(0)
  discount   Float    @default(0)
  tax        Float    @default(0)
  total      Float    @default(0)
  validUntil DateTime?
  version    Int      @default(1)
  parentId   String?  // previous version for versioning
  createdAt  DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead    Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items   QuoteItem[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

model QuoteItem {
  id         String  @id @default(cuid())
  quoteId    String
  productName String
  qty        Float   @default(1)
  unitPrice  Float   @default(0)
  discount   Float   @default(0)
  total      Float   @default(0)
  position   Int     @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Product {
  id          String  @id @default(cuid())
  orgId       String
  sku         String
  name        String
  description String?
  price       Float   @default(0)
  currency    String  @default("USD")
  unit        String  @default("each")
  stock       Float   @default(0)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, sku])
}

model PriceBook {
  id       String  @id @default(cuid())
  orgId    String
  name     String
  currency String @default("USD")
  active   Boolean @default(true)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, active])
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCSMART — Document records, extracted fields
// ─────────────────────────────────────────────────────────────────────────────

model DocumentRecord {
  id            String   @id @default(cuid())
  orgId         String
  filename      String
  mime          String
  size          Int
  status        String   @default("pending") // pending|processing|classified|extracted|reviewed|approved|rejected
  uploadedById  String?
  batchId       String?
  classification String? // invoice | contract | receipt | id | form | other
  createdAt     DateTime @default(now())

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  fields     DocumentField[]

  @@index([orgId, status])
  @@index([batchId])
}

model DocumentField {
  id         String  @id @default(cuid())
  documentId String
  key        String
  value      String?
  confidence Float  @default(0)
  reviewed   Boolean @default(false)

  document DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTOPILOT — Automations and runs
// ─────────────────────────────────────────────────────────────────────────────

model Automation {
  id              String   @id @default(cuid())
  orgId           String
  name            String
  triggerType     String   // lead_created | quote_accepted | doc_uploaded | sla_breach | schedule | manual
  triggerConfig   String?  // JSON
  conditionConfig String?  // JSON
  actionConfig    String?  // JSON
  status          String   @default("draft") // draft | active | paused
  version         Int      @default(1)
  createdAt       DateTime @default(now())

  org  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([orgId, status])
}

model AutomationRun {
  id           String    @id @default(cuid())
  automationId String
  orgId        String
  status       String    @default("queued") // queued|running|success|failed|awaiting_approval
  startedAt    DateTime?
  finishedAt   DateTime?
  error        String?

  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([automationId, status])
  @@index([orgId, startedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ERPHUB — Customers, orders, invoices, payments
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  email     String?
  phone     String?
  type      String   @default("individual") // individual | business
  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orders   Order[]
  invoices Invoice[]

  @@index([orgId])
}

model Order {
  id         String   @id @default(cuid())
  orgId      String
  number     String
  customerId String
  status     String   @default("pending") // pending | processing | shipped | delivered | cancelled
  total      Float    @default(0)
  createdAt  DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice  Invoice?

  @@unique([orgId, number])
  @@index([orgId, status])
}

model Invoice {
  id         String    @id @default(cuid())
  orgId      String
  number     String
  customerId String
  orderId    String?  @unique
  amount     Float     @default(0)
  status     String    @default("draft") // draft | sent | paid | overdue
  dueAt      DateTime?
  createdAt  DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

model Payment {
  id        String   @id @default(cuid())
  orgId     String
  invoiceId String
  amount    Float
  method    String   // card | bank | cash | crypto | wallet
  paidAt    DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CONNECT — Integrations & webhook events
// ─────────────────────────────────────────────────────────────────────────────

model Integration {
  id         String    @id @default(cuid())
  orgId      String
  provider   String    // stripe | hubspot | slack | gmail | quickbooks | zapier | meta | google
  status     String    @default("disconnected") // connected|degraded|reauth_required|error|disconnected
  config     String?   // JSON
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  orgId     String
  provider  String
  eventId   String
  payload   String?  // JSON
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, provider, processed])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT — Questionnaires / readiness scoring
// ─────────────────────────────────────────────────────────────────────────────

model AuditQuestionnaire {
  id          String   @id @default(cuid())
  orgId       String
  version     Int      @default(1)
  answers     String?  // JSON
  scoreVersion String
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, version])
}

// ─────────────────────────────────────────────────────────────────────────────
// OWNER AI — Conversations & messages
// ─────────────────────────────────────────────────────────────────────────────

model AiConversation {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  title     String
  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([orgId, userId])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant | system | tool
  content        String
  toolCalls      String?  // JSON
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
