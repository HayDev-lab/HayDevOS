# Server-only Prisma connection. For a serverless deployment, use the Supabase
# transaction pooler on port 6543 and keep pgbouncer=true.
DATABASE_URL="postgresql://haydev_runtime.PROJECT_REF:REPLACE_ME@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"

# Prisma migrations and the SQLite copy use a session connection on port 5432.
# Do not add pgbouncer=true to this URL. The direct IPv6 host is also valid from
# an IPv6-capable runner.
DIRECT_URL="postgresql://postgres.PROJECT_REF:REPLACE_ME@REGION.pooler.supabase.com:5432/postgres?sslmode=require&schema=public"

# Used only by `npm run db:migrate:sqlite`; never used by the running app.
SQLITE_SOURCE_URL="file:../db/custom.db.before-supabase-20260925"

# Public hostname consumed by Caddy. Production validation rejects missing,
# wildcard, localhost, IP-address, URL-shaped, and placeholder values.
HAYDEV_DOMAIN="app.example.com"

# Comma-separated canonical browser origins accepted for unsafe requests.
APP_ORIGINS="https://app.example.com"

# Server-only Supabase Storage credentials. Use a modern `sb_secret_...` key
# (or the legacy service-role key during migration), never a publishable/anon
# key. Do not expose these through NEXT_PUBLIC_* variables.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_replace_me"
HAYDEV_DOCUMENT_BUCKET="haydev-documents"
HAYDEV_DOCUMENT_SIGNED_URL_TTL_SECONDS="60"

# Optional: activate the Supabase Edge LeadOS export path after the function is
# deployed. Leave unset to keep the compatibility export on Next.js.
# SUPABASE_EDGE_EXPORT_URL="https://PROJECT_REF.supabase.co/functions/v1/leados-export"

# Temporary server-only compatibility header while the hosted Storage API
# rejects the modern opaque key for object operations. Remove after a verified
# modern-key smoke; never expose or commit the real compact JWT.
# SUPABASE_STORAGE_AUTH_JWT="eyJ...legacy-service-role-jwt"

# Managed malware scanner. User uploads remain quarantined unless the provider
# returns a trusted CLEAN verdict. Never expose this key to client code.
MALWARE_SCANNER_PROVIDER="metadefender"
METADEFENDER_API_KEY="replace-in-host-secret-store"
MALWARE_SCANNER_TIMEOUT_MS="60000"
MALWARE_SCANNER_RETRIES="2"

# Ollama Cloud OpenAI-compatible endpoint. The API key is server-only. Owner AI
# fails closed in production when the configured provider is unavailable.
OWNER_AI_BASE_URL="https://ollama.com/v1"
OWNER_AI_API_KEY="replace-in-host-secret-store"
OWNER_AI_MODEL="glm-5.3-flash:cloud"
OWNER_AI_TIMEOUT_MS="120000"

# Optional Owner AI backend: leave unset (or use "openai-compatible") for
# the existing provider. `openclaw-broker` is a server-only, signed bridge to
# a dedicated HayDevOS broker; it must never point to a raw OpenClaw Gateway.
# OWNER_AI_BACKEND="openclaw-broker"
# HAYDEV_OPENCLAW_BROKER_URL="http://127.0.0.1:19790"
# A broker beyond loopback must use HTTPS, e.g. https://broker.internal.example.
# HAYDEV_OPENCLAW_BROKER_TOKEN="replace-in-host-secret-store"
# HAYDEV_OPENCLAW_BROKER_HMAC_KEY="replace-with-32-or-more-secret-characters"

# Structured error delivery and release correlation. The webhook is optional;
# readiness still reports configuration and dependency health separately.
ERROR_WEBHOOK_URL="https://monitoring.example.com/hooks/replace-me"
HAYDEV_RELEASE="git-sha-or-release-id"
HAYDEV_ENVIRONMENT="production"

# Development only. Production builds ignore this flag and never expose the
# synthetic Owner AI read datasets.
HAYDEV_ALLOW_DEMO_DATA="false"

# One-time production bootstrap (`npm run auth:bootstrap`). Remove these from
# the runtime environment immediately after the command succeeds.
HAYDEV_BOOTSTRAP_EMAIL="owner@example.com"
HAYDEV_BOOTSTRAP_NAME="Platform Owner"
HAYDEV_BOOTSTRAP_PASSWORD="replace-with-a-strong-password"
HAYDEV_BOOTSTRAP_ORG_NAME="Example Company"
HAYDEV_BOOTSTRAP_ORG_SLUG="example-company"

# Keep identical across all Next.js instances when Server Actions are added.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-base64-32-byte-key"
